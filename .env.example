# Instance root, without /api/v1. HTTPS for remote connections.
FIREFLY_BASE_URL=https://firefly.example.com
FIREFLY_API_TOKEN=replace-with-your-personal-access-token
# On an existing private Docker network, the URL may instead be:
# FIREFLY_BASE_URL=http://firefly-service:8080

# Compose host publishing; same-host reverse proxy by default.
# For a remote proxy, use the host's private IP AND a proxy-only Docker firewall rule.
EMBER_BIND_ADDRESS=127.0.0.1
EMBER_PORT=3000

# Optional bundled HTTPS: use compose.yaml + compose.https.yaml.
# Needs a public DNS hostname and reachable TCP ports 80/443; no existing proxy needed.
# The private Ember HTTP port is not published in this mode.
EMBER_HTTPS_BIND_ADDRESS=0.0.0.0
# Migration/restore only, with compose.auth-state.yaml: verified existing volume name.
# EMBER_AUTH_STATE_VOLUME=your-existing-project_ember-auth-state

# Built-in single-user login. See README for the interactive hash/secret generators.
# Development only: http://127.0.0.1:3000. Production REQUIRES your public HTTPS origin.
EMBER_APP_URL=https://finance.example.com
EMBER_AUTH_USERNAME=replace-with-your-username
# Keep bcrypt hashes single-quoted in Compose .env files so $ is literal.
EMBER_AUTH_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
EMBER_AUTH_SECRET=replace-with-generated-session-secret
